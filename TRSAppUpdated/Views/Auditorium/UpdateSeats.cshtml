@model List<RowSeatInputVM>
@{
    ViewData["Title"] = "Update Columns";
    var _Message = TempData["Message"] as string;
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <h4>
                    @(ViewData["Title"])
                    <span class="float-right">
                        <a href="@(Url.Action("Index"))" class="btn btn-danger ml-2">Back</a>
                    </span>
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="UpdateSeats" method="post">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>Number of Columns</th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model[i].RowLabel
                                        <input type="hidden" asp-for="@Model[i].RowID" />
                                        <input type="hidden" asp-for="@Model[i].RowLabel" />
                                    </td>
                                    @for (int j = 0; j < Model[i].Columns.Count; j++)
                                    {
                                        <td>
                                            <span>Column # @Model[i].Columns[j].ColumnNumber</span>
                                            <input type="hidden" name="[@i].Columns[@j].ColumnID" value="@Model[i].Columns[j].ColumnID" />
                                            <input type="number" name="[@i].Columns[@j].SeatCount" value="@Model[i].Columns[j].SeatCount" class="form-control form-control-sm" />
                                            <span asp-validation-for="@Model[i].Columns[j].SeatCount"></span>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="@(Url.Action("Index"))" class="btn btn-danger ml-2">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        @if (_Message != null)
        {
            if (_Message.StartsWith("1"))
            {
                <text>
                                    Lobibox.notify('success', {
                                    pauseDelayOnHover: true,
                                    size: 'mini',
                                    icon: 'bx bx-info-circle',
                                    continueDelayOnInactiveTab: false,
                                    position: 'bottom right',
                                    msg: '@(_Message.Substring(2))',
                                    soundPath: '/assets/sounds/'
                                    });
                </text>
            }
            else
            {
                <text>
                                    Lobibox.notify('error', {
                                    pauseDelayOnHover: true,
                                    size: 'mini',
                                    icon: 'bx bx-info-circle',
                                    continueDelayOnInactiveTab: false,
                                    position: 'bottom right',
                                    msg: '@(_Message.Substring(2))',
                                    soundPath: '/assets/sounds/'
                                    });
                </text>
            }
        }
    </script>
}
