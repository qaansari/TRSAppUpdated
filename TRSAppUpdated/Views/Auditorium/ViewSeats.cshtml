@model SeatVM
@{
    ViewData["Title"] = "Seats";
    Layout = "_EmptyLayout";
    int _TSeats=Model.Rows.SelectMany(x => x.Columns).SelectMany(x => x.Seats).Count();
}
<style>
    .loader{
        display:none;
    }
</style>
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="info w-100">
            <div class="form-group mb-0 float-right my-2 mr-5px">
                <a class="btn btn-danger btn-sm" href="@(Url.Action("Index"))">Back</a>
            </div>
            <h1 class="fw-bold text-uppercase text-center">@Model.AuditoriumName</h1>
            <h2 class="fw-medium text-uppercase text-center">@Model.VenueName</h2>
            <h3 class="fw-medium text-uppercase text-center">@(_TSeats) SEATS</h3>
        </div>
        <div class="w-100">
            @foreach (var row in Model.Rows)
            {
                <div class="seat-row mt-2">
                    <span class="row_label  mr-5px">@(row.RowLabel)</span>
                    @if (Model.AuditoriumAlignment.ToLower() == "right")
                    {
                        row.Columns = row.Columns.ToList().AsEnumerable().Reverse().ToList();
                    }
                    @foreach (var column in row.Columns)
                    {
                        if (column.Seats.Count > 0)
                        {
                            @if (Model.AuditoriumAlignment.ToLower() == "right")
                            {
                                column.Seats= column.Seats.ToList().AsEnumerable().Reverse().ToList();
                            }
                            @foreach (var seat in column.Seats)
                            {
                                <div class="@(_TSeats <= 450 ? "seat_bigger" : "seat")">
                                    @seat
                                </div>
                            }
                            <div class="column-gap"></div>
                        }
                    }
                    <span class="row_label">@(row.RowLabel)</span>
                </div>
            }
        </div>
    </div>
</div>

