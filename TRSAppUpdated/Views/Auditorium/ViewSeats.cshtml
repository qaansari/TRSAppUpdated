@model SeatVM
@{
    ViewData["Title"] = "Seats";
    Layout = "_EmptyLayout";
}
<div class="info w-100">
    <h1 class="fw-bold text-uppercase text-center">@Model.AuditoriumName</h1>
    <h2 class="fw-medium text-uppercase text-center">@Model.VenueName</h2>
</div>
@foreach (var _row in Model.Rows)
{
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <span class="row_label">@(_row.RowLabel)</span>
            <div class="columns">
                @foreach (var _column in _row.Columns)
                {
                    foreach (var _seat in _column.Seats)
                    {
                        <span class="seat">@_seat</span>
                    }
                }
            </div>
            <span class="row_label">@(_row.RowLabel)</span>
        </div>
    </div>
}
