@model SeatVM
@{
    ViewData["Title"] = "Seats";
    Layout = "_EmptyLayout";
    int _TSeats = Model.Rows?.SelectMany(x => x.Columns).SelectMany(x => x.Seats).Count() ?? 0;
    bool isRightAligned = string.Equals(Model.AuditoriumAlignment, "right", StringComparison.OrdinalIgnoreCase);
}
<style>
    .loader{
        display:none;
    }
</style>
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="info w-100">
            <div class="form-group mb-0 float-right my-2 mr-5px">
                <a class="btn btn-danger btn-sm" href="@(Url.Action("Index"))">Back</a>
            </div>
            <h1 class="fw-bold text-uppercase text-center">@Model.AuditoriumName</h1>
            <h2 class="fw-medium text-uppercase text-center">@Model.VenueName</h2>
            <h3 class="fw-medium text-uppercase text-center">@(_TSeats) SEATS</h3>
        </div>
        <div class="w-100">
            @if (Model.Rows != null)
            {
                var rows = Model.Rows.OrderBy(r => r.ID).ToList();
                @foreach (var row in rows)
                {
                    var columns = row.Columns != null ? row.Columns.OrderBy(c => c.ColumnNumber).ToList() : new List<ColumnVM>();
                    if (isRightAligned)
                    {
                        columns.Reverse();
                    }
                    <div class="seat-row mt-2">
                        <span class="row_label mr-5px">@(row.RowLabel)</span>
                        @foreach (var column in columns)
                        {
                            if (column.Seats != null && column.Seats.Count > 0)
                            {
                                var seats = column.Seats.OrderBy(s => s).ToList();
                                if (isRightAligned)
                                {
                                    seats.Reverse();
                                }
                                @foreach (var seat in seats)
                                {
                                    <div class="@(_TSeats <= 450 ? "seat_bigger" : "seat")">
                                        @seat
                                    </div>
                                }
                                <div class="column-gap"></div>
                            }
                        }
                        <span class="row_label">@(row.RowLabel)</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

