@model ReservationDetailVM
@{
    int _EventID = ViewBag.EventID != null ? ViewBag.EventID : 0;
    string _PageTitle = "Reservation Details";
    ViewData["Title"] = _PageTitle;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
    bool isModerator = (await _authorizationService.AuthorizeAsync(User, "Moderator")).Succeeded ? true : false;
    bool isUser = (await _authorizationService.AuthorizeAsync(User, "User")).Succeeded ? true : false;
    if (isModerator || isUser)
    {
        Layout = "_EmptyLayout";
    }
}
<style type="text/css">
    .ticket-container {
        width: 1200px;
        height: 660px;
        max-width: 1200px;
        max-height: 660px;
        margin: 0;
        background: rgb(255,255,255);
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .ticket-header {
        background: linear-gradient(135deg, rgb(26,164,139), rgb(69,165,121));
        color:  rgb(255,255,255);
        padding: 20px;
        text-align: center;
    }

        .ticket-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }


    .ticket-body {
        padding: 0 15px 0 15px;
    }
    .ticket_heading{
        text-align:center;
        text-transform:uppercase;
    }
     .ticket_heading h2{
        font-size:24px;
        color:rgb(26,164,139);
    }
    .ticket-content{
        display:flex;
    }
    .ticket-info {
        width:50%;
        margin-bottom: 10px;
         height:auto;
    }
    .image-info{
                width:50%;
                height:auto;
    }
    .image-info img{
        border-radius: 10px;
    }

    .payment-info {
        margin-bottom: 20px;
    }

    .info-row {
        display: flex;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgb(238,238,238);
    }

    .info-label {
        font-weight: 600;
        width: 200px;
        color: rgb(19, 7, 22);
    }

    .info-value {
        flex: 1;
        color: rgb(10, 3, 3);
    }

    .ticket-number {
        background: rgb(248, 249, 250);
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin: 20px 0;
        border: 1px dashed rgb(221,221,221);
    }

        .ticket-number h3 {
            margin: 0;
            font-size: 28px;
            color: rgb(26,164,139);
            letter-spacing: 2px;
            text-align: center;
            text-transform: uppercase;
        }

    .payment-info h3 {
        margin: 10px;
        font-size: 18px;
        color: rgb(26,164,139);
        letter-spacing: 2px;
        padding: 5px 10px;
        text-align: center;
        text-transform: uppercase;
    }

    .logo_img_section {
    width: 100%;
    text-align: center;
}
.logo_img {
    width: 200px;
    height: 100px;
}

    .footer {
        text-align: center;
        padding: 15px;
        color: rgb(153,153,153);
        font-size: 12px;
        background: rgb(249,249,249);
        border-top: 1px solid rgb(238,238,238);
    }

    .seats-badge {
        display: inline-block;
        background: rgb(88,255,217);
        color: rgb(16,12,12);
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: 600;
        margin-right: 5px;
        margin-bottom: 5px;
    }
</style>
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="info w-100">
            <div class="form-group mb-0 float-right my-2 mr-5px">
                <button type="button" class="btn btn-primary" id="downloadBtn">Get PDF</button>
                <a class="btn btn-danger" href="@(Url.Action("Details", "Event", new { ID = _EventID }))">Back</a>
            </div>
        </div>
    </div>
</div>
<div class="row mb-2">
<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
    <div class="ticket-container">
        <div class="ticket-header">
            <h2>E-Ticket</h2>
        </div>
        <div class="ticket-body">
            @if (Model.ID != 0)
            {
                <div class="logo_img_section">
                    <img src="~/assets/images/web-logo-light.png" class="logo_img" />
                </div>
                <div class="ticket_heading">
                     <h2>E-Ticket</h2>
                </div>
                <div class="ticket-number">
                    <h3>@Model.TicketNumber</h3>
                </div>
                
                <div class="ticket-content">
                <div class="ticket-info">
                    <div class="info-row">
                        <div class="info-label">Event Name:</div>
                        <div class="info-value">@Model.EventName</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Show Date:</div>
                        <div class="info-value">@Model.ShowDateTime</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Customer Name:</div>
                        <div class="info-value">@Model.CustomerName</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Phone Number:</div>
                        <div class="info-value">@Model.CustomerPhone</div>
                    </div>
                    <div class="info-row">
                        @{
                                    int _count = Model.SeatLabels.Split(',').Count();
                         }
                        <div class="info-label">Reserved Seats:
                            (@(_count))
                        </div>
                        <div class="info-value">
                                
                            @foreach (var seat in Model.SeatLabels.Split(','))
                            {
                                <span class="seats-badge">@seat.Trim()</span>
                            }
                        </div>
                    </div>
                </div>
                 @if (!string.IsNullOrEmpty(Model.EventImagePath))
                    {
                <div class="image-info">
                            <img src="~/assets/images/events/@(Model.EventImagePath)" />
                        </div>
                    }
                </div>
            }
            else
            {
                <p>No reservation details found.</p>
            }
             
        </div>
        <div class="footer">
            Thank you for your reservation. Please present this ticket at the venue.
        </div>
    </div>
    </div>
    </div>
    @if (isSuperAdmin || isAdmin)
    {
        <div class="row mt-2">
        <div class="ticket-container">
            <div class="ticket-header">
                <h2>Payment Information</h2>
            </div>
            <div class="ticket-body">
                @if (Model.ID != 0)
                {
                    <div class="logo_img_section">
                        <img src="~/assets/images/web-logo-light.png" class="logo_img" />
                    </div>
                    <div class="ticket-number">
                        <h3>@Model.PaymentModeTitle</h3>
                    </div>
                    @if (Model.BookingDateTime.HasValue)
                    {
                        <div class="info-row">
                            <div class="info-label">Booking Date:</div>
                            <div class="info-value">@Model.BookingDateTime.Value.ToString("dddd, dd MMMM yyyy, hh:mm tt")</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TransactionID))
                        {
                            <div class="info-row">
                                <div class="info-label">Trax ID:</div>
                                <div class="info-value">@Model.TransactionID</div>
                            </div>
                        }
                    <div class="ticket-info">
                        <div class="info-row">
                            <div class="info-label">Cost Price:</div>
                            <div class="info-value">@Model.CostPrice</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Sale Price:</div>
                            <div class="info-value">@Model.SalePrice</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Amount Paid:</div>
                            <div class="info-value">@Model.AmountPaid</div>
                        </div>
                        @if (!Model.IsFullyPaid || Model.AmountRemaining > 0)
                        {
                            <div class="info-row">
                                <div class="info-label">Amount Remaining:</div>
                                <div class="info-value">@Model.AmountRemaining</div>
                            </div>
                        }
                     
                    </div>
                }
                else
                {
                    <p>No reservation details found.</p>
                }
            </div>
            <div class="footer">
                Thank you for your reservation. Please present this ticket at the venue.
            </div>
        </div>
        </div>
        if (!string.IsNullOrEmpty(Model.ReservationImages))
        {

            string _formattedEventTitle = Model.EventName.Trim().Contains(" ") ?
            Model.EventName.Trim().Replace(" ", "") : Model.EventName.Trim();
                     <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12 mt-2">
            <div class="ticket-container">
                <div class="ticket-header">
                    <h2>Payment Transactions</h2>
                </div>
                <div class="ticket-body">
                    <div class="row m-2">
                        @foreach (var _img in Model.ReservationImages.Split(','))
                        {
                            <div class="col-md-6">
                                <img src="~/assets/images/reservations/@(_formattedEventTitle)/@(_img)" class="reservation_image_preview"/>
                            </div>
                        }
                    </div>
                </div>
                <div class="footer">
                    Thank you for your reservation. Please present this ticket at the venue.
                </div>
            </div>
            </div>
        }
    }
    @section Scripts{
        <script>
    $(document).ready(function () {
        $('#downloadBtn').click(function (e) {
            e.preventDefault();

            // Show loader
            $('.loader').fadeIn();

            // Start file download
            const downloadUrl = '@Url.Action("GetPDF", "Reservation")?ID=@Model.ID&EventID=@_EventID';
            window.location.href = downloadUrl;

            // Hide loader after 5–10 seconds (adjust as needed)
            setTimeout(function () {
                $('.loader').fadeOut();
            }, 500);
        });
    });
</script>
    }
