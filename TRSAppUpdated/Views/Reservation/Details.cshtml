@model ReservationDetailVM
@{
    int _EventID = ViewBag.EventID != null ? ViewBag.EventID : 0;
    string _PageTitle = "Reservation Details";
    ViewData["Title"] = _PageTitle;
}
<style type="text/css">
    .ticket-container {
        max-width: 600px;
        margin: 0;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .ticket-header {
        background: linear-gradient(135deg, #1aa48b, #45a579);
        color: white;
        padding: 20px;
        text-align: center;
    }

        .ticket-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }

    .ticket-body {
        padding: 0 15px 0 15px;
    }

    .ticket-info {
        margin-bottom: 10px;
    }

    .payment-info {
        margin-bottom: 20px;
    }

    .info-row {
        display: flex;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #eee;
    }

    .info-label {
        font-weight: 600;
        width: 150px;
        color: #130716;
    }

    .info-value {
        flex: 1;
        color: #0a0303;
    }

    .ticket-number {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin: 20px 0;
        border: 1px dashed #ddd;
    }

        .ticket-number h3 {
            margin: 0;
            font-size: 28px;
            color: #1aa48b;
            letter-spacing: 2px;
            text-align: center;
            text-transform: uppercase;
        }

    .payment-info h3 {
        margin: 10px;
        font-size: 18px;
        color: #1aa48b;
        letter-spacing: 2px;
        padding: 5px 10px;
        text-align: center;
        text-transform: uppercase;
    }

    .footer {
        text-align: center;
        padding: 15px;
        color: #999;
        font-size: 12px;
        background: #f9f9f9;
        border-top: 1px solid #eee;
    }

    .seats-badge {
        display: inline-block;
        background: #58ffd9;
        color: #100c0c;
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: 600;
        margin-right: 5px;
        margin-bottom: 5px;
    }
</style>
<div class="row mb-1">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="info w-100">
            <div class="form-group mb-0 float-right my-2 mr-5px">
                <a class="btn btn-danger" href="@(Url.Action("Details", "Event", new { ID = _EventID }))">Back</a>
            </div>
        </div>
    </div>
</div>
<div class="d-flex justify-content-center">
    <div class="ticket-container">
        <div class="ticket-header">
            <h2>E-Ticket</h2>
        </div>
        <div class="ticket-body">
            @if (Model.ID != 0)
            {
                <div class="ticket-number">
                    <h3>@Model.TicketNumber</h3>
                </div>
                <div class="ticket-info">
                    <div class="info-row">
                        <div class="info-label">Event Name:</div>
                        <div class="info-value">@Model.EventName</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Show Date:</div>
                        <div class="info-value">@Model.ShowDateTime</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Customer Name:</div>
                        <div class="info-value">@Model.CustomerName</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Phone Number:</div>
                        <div class="info-value">@Model.CustomerPhone</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Reserved Seats:</div>
                        <div class="info-value">
                            @foreach (var seat in Model.SeatLabels.Split(','))
                            {
                                <span class="seats-badge">@seat.Trim()</span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p>No reservation details found.</p>
            }
        </div>
        <div class="footer">
            Thank you for your reservation. Please present this ticket at the venue.
        </div>
    </div>
    <div class="ticket-container ml-2">
        <div class="ticket-header">
            <h2>Payment Information</h2>
        </div>
        <div class="ticket-body">
            @if (Model.ID != 0)
            {
                <div class="ticket-number">
                    <h3>@Model.PaymentModeTitle</h3>
                </div>
                <div class="ticket-info">
                    <div class="info-row">
                        <div class="info-label">Cost Price:</div>
                        <div class="info-value">@Model.CostPrice</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Sale Price:</div>
                        <div class="info-value">@Model.SalePrice</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Amount Paid:</div>
                        <div class="info-value">@Model.AmountPaid</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Amount Remaining:</div>
                        <div class="info-value">@Model.AmountRemaining</div>
                    </div>
                    @if (!Model.IsFullyPaid || Model.AmountRemaining > 0)
                    {
                        <div class="info-row">
                            <div class="info-label">Amount Remaining:</div>
                            <div class="info-value">@Model.AmountRemaining</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>No reservation details found.</p>
            }
        </div>
        <div class="footer">
            Thank you for your reservation. Please present this ticket at the venue.
        </div>
    </div>
</div>

