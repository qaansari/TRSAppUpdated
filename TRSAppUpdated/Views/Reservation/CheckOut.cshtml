@model PaymentMethodRequestVM
@{
    ViewData["Title"] = "Checkout";
    var paymentModeReqVM = ViewData["PaymentMethodModel"] as PaymentMethodRequestVM ?? new PaymentMethodRequestVM();
    var _Message = TempData["Message"] as string;
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <h4>@(ViewData["Title"])</h4>
            </div>
            <div class="card-body">
                <form class="separate-form" enctype="multipart/form-data" method="post" asp-action="SubmitCheckOut">
                    <input type="hidden" name="ShowID" />
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="row">
                            <input type="hidden" asp-for="ShowID" />
                            <input type="hidden" asp-for="EventID" />
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Customer Name <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Your Name" asp-for="CustomerName"
                                           readonly="@(!string.IsNullOrEmpty(Model.CustomerName) ? true : false)">
                                    <span asp-validation-for="CustomerName"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Customer Phone <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Your Contact Number" asp-for="CustomerPhone" 
                                    readonly="@(!string.IsNullOrEmpty(Model.CustomerPhone)?true:false)">
                                    <span asp-validation-for="CustomerPhone"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Customer Phone <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Your Contact Number" asp-for="CustomerPhone">
                                    <span asp-validation-for="CustomerPhone"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Amount <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" asp-for="Amount" disabled="true">
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group mb-0">
                                    <input class="btn btn-primary" type="submit">
                                    <a class="btn btn-danger" href="@(Url.Action("Details", "Event", new { ID = Model.EventID }))">Back</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}

