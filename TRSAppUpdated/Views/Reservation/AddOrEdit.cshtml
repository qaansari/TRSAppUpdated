@using Newtonsoft.Json
@model ReservationVM
@{
    string _fn = "Add";
    if (Model.ID != 0)
    {
        _fn = "Edit";
    }
    string _PageTitle = "Reservation";
    ViewData["Title"] = $"{_fn} {_PageTitle}";
    var _Message = TempData["Message"] as string;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
}
@if (isSuperAdmin || (isAdmin && Model.ID == 0))
{
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-header">
                    <h4>@(ViewData["Title"])</h4>
                </div>
                <div class="card-body">
                    <form class="separate-form rsv_form" enctype="multipart/form-data" method="post" asp-action="AddOrEdit">
                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="ClosedByUserID" />
                        <input type="hidden" asp-for="ClosingDateTime" />
                        <input type="hidden" asp-for="TicketNumber" />
                        <input type="hidden" asp-for="EventID" />
                        <input type="hidden" asp-for="CreatedByUserID" />
                        <input type="hidden" asp-for="CreatedDateTime" />
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Customer Name <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Customer Name" asp-for="CustomerName">
                                    <span asp-validation-for="CustomerName"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Phone # <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Customer Phone #" asp-for="CustomerPhone">
                                    <span asp-validation-for="CustomerPhone"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Show <span class="text-danger">*</span></label>
                                    <ejs-dropdownlist cssClass="form-control form-control-sm" dataSource="@(ViewData["ShowList"])" placeholder="Select a show"
                                                      allowFiltering="true" ejs-for="ShowID" popupHeight="220px" change="showChange">
                                        <e-dropdownlist-fields value="ID" text="ShowDateTime"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <span asp-validation-for="ShowID"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Tickets <span class="text-danger">*</span></label>
                                    <ejs-multiselect cssClass="form-control form-control-sm" dataSource="@(ViewData["TicketList"])" placeholder="Select tickets"
                                                     allowFiltering="true" ejs-for="TicketIDs" popupHeight="220px" enabled="@(Model.ID == 0 ? false : true)">
                                        <e-multiselect-fields value="ID" text="FormattedSeatNumber"></e-multiselect-fields>
                                    </ejs-multiselect>
                                    <span asp-validation-for="TicketIDs"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Cost Price <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" placeholder="Enter Cost Price" asp-for="CostPrice" readonly>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Sale Price <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" placeholder="Enter Sale Price" asp-for="SalePrice">
                                    <span asp-validation-for="SalePrice"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Discount</label>
                                    <input class="form-control" type="number" placeholder="Enter Discount" asp-for="Discount" readonly>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Amount Paid<span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" placeholder="Enter Amount Paid" asp-for="AmountPaid">
                                    <span asp-validation-for="AmountPaid"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Amount Remaining<span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" placeholder="Enter Amount Remaining" asp-for="AmountRemaining" readonly="true">
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Reservation Status <span class="text-danger">*</span></label>
                                    <ejs-dropdownlist cssClass="form-control form-control-sm" dataSource="@(ViewData["ReservationStatusList"])" placeholder="Select an reservation status"
                                                      allowFiltering="true" ejs-for="ReservationStatusID" popupHeight="220px">
                                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <span asp-validation-for="ReservationStatusID"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Payment Mode <span class="text-danger">*</span></label>
                                    <ejs-dropdownlist id="PaymentMode" cssClass="form-control form-control-sm" dataSource="@(ViewData["PaymentModeList"])" placeholder="Select a payment mode"
                                                      allowFiltering="true" ejs-for="PaymentModeID" popupHeight="220px">
                                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <span asp-validation-for="PaymentModeID"></span>
                                </div>
                            </div>
                            @if (isSuperAdmin)
                            {
                                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <input id="isApprovedChk" type="checkbox" name="IsApproved" @(Model.IsApproved != null && Model.IsApproved.Value == true ? "checked" : "")>
                                            <label for="isApprovedChk">Approved</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="col-form-label">Action By User</label>
                                        <ejs-dropdownlist cssClass="form-control form-control-sm" dataSource="@(ViewData["UserList"])" placeholder="Select a user"
                                                          allowFiltering="true" ejs-for="ActionByUserID" popupHeight="220px">
                                            <e-dropdownlist-fields value="ID" text="FullName"></e-dropdownlist-fields>
                                        </ejs-dropdownlist>
                                        <span asp-validation-for="ActionByUserID"></span>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="col-form-label">Action Date Time</label>
                                        <ejs-datetimepicker cssClass="form-control" ejs-for="ActionDateTime"></ejs-datetimepicker>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="ActionByUserID" />
                                <input type="hidden" asp-for="ActionDateTime" />
                            }
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Booking Date Time</label>
                                    <ejs-datetimepicker cssClass="form-control" ejs-for="BookingDateTime"></ejs-datetimepicker>
                                </div>
                            </div>
                        </div>
                        <div class="row optional-row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Photo(s)</label>
                                    <input class="form-control" type="file" asp-for="ImageFile" accept="image/*">
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Transaction ID <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" asp-for="TransactionID">
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <img src="~/assets/images/no-image-found.png" class="reservation_image_preview" id="imgPreview" />
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Extracted Text</label>
                                    <textarea class="form-control reservation_textarea" rows="5" id="extractedText"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group mb-0 mt-2">
                                    <button class="btn btn-primary rsvSumbitButton" type="button">Save</button>
                                    <a class="btn btn-danger" href="@(Url.Action("Details", "Event", new { ID = Model.EventID }))">Back</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script>
        function showChange() {
            var showObj = document.getElementById('ShowID').ej2_instances[0];
            var tickets = document.getElementById('TicketIDs').ej2_instances[0];
            tickets.enabled = true;
            var tempQuery = new ej.data.Query().where('ShowID', 'equal', showObj.value);
            tickets.query = tempQuery;
            tickets.text = null;
            tickets.dataBind();
        }
    </script>

    @section Scripts {
        <script>
            const ticketList = @Html.Raw(JsonConvert.SerializeObject(ViewData["TicketList"]));
            console.log(ticketList);
            function getSelectedTicketCost(ticketIds) {
                if (!ticketIds || !ticketList) return 0;

                let total = 0;
                ticketList.forEach(ticket => {
                    if (ticketIds.includes(ticket.ID)) {
                        total += parseFloat(ticket.CostPrice) || 0;
                    }
                });
                console.log();
                return total;
            }

            function updateCostPrice() {
                try {
                    const ticketDropdown = $('[name="TicketIDs"]');
                    const ticketIds = $(ticketDropdown).val()?.map(x => parseInt(x)) || [];
                    const cost = getSelectedTicketCost(ticketIds);
                    console.log(cost);
                    $('[name="CostPrice"]').val(cost.toFixed(2));
                    updateDiscount();
                    updateAmountRemaining();
                } catch (e) {
                    console.error("Error in updateCostPrice:", e);
                }
            }

            function updateDiscount() {
                try {
                    const costPrice = parseFloat($('[name="CostPrice"]').val()) || 0;
                    const salePrice = parseFloat($('[name="SalePrice"]').val()) || 0;

                    if (salePrice > costPrice) {
                        alert('Sale Price cannot be greater than Cost Price.');
                        $('[name="SalePrice"]').val('');
                        $('[name="Discount"]').val('');
                        return;
                    }
                    const discount = costPrice - salePrice;
                    $('[name="Discount"]').val(discount.toFixed(2));
                } catch (e) {
                    console.error("Error in updateDiscount:", e);
                }
            }

            function updateAmountRemaining() {
                try {
                    const salePrice = parseFloat($('[name="SalePrice"]').val()) || 0;
                    const amountPaid = parseFloat($('[name="AmountPaid"]').val()) || 0;

                    if (amountPaid > salePrice) {
                        alert('Amount Paid cannot be greater than Sale Price.');
                        $('[name="AmountPaid"]').val('');
                        $('[name="AmountRemaining"]').val('');
                        return;
                    }

                    const remaining = salePrice - amountPaid;
                    $('[name="AmountRemaining"]').val(remaining.toFixed(2));
                } catch (e) {
                    console.error("Error in updateAmountRemaining:", e);
                }
            }

            function toggleOptionalRow() {
                try {
                     const dropdownObj = document.getElementById('PaymentMode')?.ej2_instances?.[0];
                    const selectedText = dropdownObj.text?.trim().toLowerCase();
                    if (selectedText && selectedText !== 'cash') {
                        $('.optional-row').slideDown();
                    } else {
                        $('.optional-row').slideUp();
                    }
                } catch (e) {
                    console.error("Error in toggleOptionalRow:", e);
                }
            }

            $(document).ready(function () {
                $('.rsvSumbitButton').click(function(){
                    $('.rsv_form').submit();
                });
                try {
                    $('.optional-row').hide();
                   toggleOptionalRow();
                        if ($("#isApprovedChk").is(":checked")) {
                    $("#isApprovedChk").val("true");
            } else {
                        $("#isApprovedChk").val("false");
            }
             $('#isApprovedChk').change(function() {
                    if (!$(this).is(':checked')) {
                        $(this).val(false); // Set to null if unchecked
                    } else {
                        $(this).val(true); // Set to true if checked
                    }
                });
                    // Ticket change => update cost price
                                const ticketMulti = document.getElementById('TicketIDs')?.ej2_instances?.[0];
            if (ticketMulti) {
                ticketMulti.addEventListener('change', updateCostPrice);
            }
                    // Sale price change => update discount
                    $('[name="SalePrice"]').on('input', updateDiscount);

                    // Amount paid change => update remaining
                    $('[name="AmountPaid"]').on('input', updateAmountRemaining);

                    // Payment mode change => toggle optional row
                        const paymentDropdown = document.getElementById('PaymentMode')?.ej2_instances?.[0];
                    if (paymentDropdown) {
                        paymentDropdown.addEventListener('change', toggleOptionalRow);
                    }
                    $('#ImageFile').on('change', function(event) {
                    const file = event.target.files[0];
                    if (file) {
                        const formData = new FormData();
                        formData.append('file', file);

                        $.ajax({
                            url: '/ImageProcess/ExtractTextFromImage',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function(data) {
                                $('#extractedText').val(data.text);
                            },
                            error: function(xhr, status, error) {
                                console.error('Error:', error);
                                alert('Failed to extract text from the image.');
                            }
                        });
                    }
                });
                $("#ImageFile").change(
                function PreviewSelectedImage() {
                    var imageFile = document.getElementById("ImageFile");
                    var imagePreview = document.getElementById("imgPreview");
                    var imageReader = new FileReader();
                    imageReader.onload = function (e) {
                        imagePreview.src = e.target.result;
                        imagePreview.style.display = "block";
                    };
                    imageReader.readAsDataURL(imageFile.files[0]);
                });
                } catch (e) {
                    console.error("Document ready error:", e);
                }
            });
        </script>
        @if (_Message != null)
        {
            if (_Message.StartsWith("1"))
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('success', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
            else
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('error', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
        }
    }
}
else
{
    Layout = "_EmptyLayout";
    @(await Html.PartialAsync("~/Views/Shared/_NotAuthorizedView.cshtml"))
}