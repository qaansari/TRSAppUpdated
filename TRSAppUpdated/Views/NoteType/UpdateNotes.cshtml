@model List<NoteVM>
@{
    ViewData["Title"] = "Update Notes";
    var noteDataList = Model.ToList();
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card table-card">
            <div class="card-header pb-0">
                <h4>
                    @(ViewData["Title"])
                    @if (noteDataList.Count == 0)
                    {
                        <span class="float-right">
                                    <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                        </span>
                    }
                </h4>
            </div>
            <div class="card-body @(noteDataList.Count > 0?"":"text-center")">
                @if (noteDataList.Count > 0)
                {
                    <h3>Live Preview</h3>
                    <hr />
                    <div id="livePreview"></div>
                    <form asp-action="UpdateNotes" method="post" id="seqForm">
                        <div id="noteEditor">
                            @for (int i = 0; i < noteDataList.Count; i++)
                            {
                                <div class="note-item d-flex w-100" data-index="@i">
                                    <input type="hidden" name="notes[@i].ID" value="@noteDataList[i].ID" />
                                    <input type="number" class="form-control form-control-sm seq-input" name="notes[@i].Seq" value="@noteDataList[i].Seq"
                                          data-index="@i" />
                                    <div class="text-danger invalid-feedback d-none">Duplicate Seq value</div>
                                    <textarea class="form-control" rows="3" readonly>@noteDataList[i].EnTitle</textarea>
                                    <textarea class="form-control" rows="3" readonly>@noteDataList[i].UrduTitle</textarea>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                    </form>
                }
                else
                {
                    <img class="error_img" src="~/assets/images/no-data.png" />
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const preview = document.getElementById("livePreview");
            const noteData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(noteDataList));

            function renderPreview() {
                const seqValues = {};
                const updatedNotes = [];

                const noteItems = document.querySelectorAll(".note-item");

                noteItems.forEach((item, index) => {
                    const seqInput = item.querySelector("input.seq-input");
                    const feedback = item.querySelector(".invalid-feedback");

                    const rawSeq = seqInput.value.trim();
                    const seq = parseInt(rawSeq) || 0;

                    // Default: remove error class
                    seqInput.classList.remove("is-invalid");
                    feedback.classList.add("d-none");

                    // Check for duplicate
                    if (rawSeq !== "") {
                        if (seqValues[seq]) {
                            // This is a duplicate: highlight this field
                            seqInput.classList.add("is-invalid");
                            feedback.classList.remove("d-none");
                        } else {
                            seqValues[seq] = true;
                        }
                    }

                    updatedNotes.push({
                        ...noteData[index],
                        Seq: seq
                    });
                });

                updatedNotes.sort((a, b) => a.Seq - b.Seq);

                preview.innerHTML = "";
                updatedNotes.forEach(note => {
                    const div = document.createElement("div");
                    div.innerHTML = `<strong>${note.Seq}</strong> - ${note.EnTitle} <br/><em>${note.UrduTitle}</em><hr/>`;
                    preview.appendChild(div);
                });
            }

            // Attach on change event
            document.querySelectorAll(".seq-input").forEach(input => {
                input.addEventListener("change", renderPreview);
            });

            renderPreview();
        });
    </script>
}

