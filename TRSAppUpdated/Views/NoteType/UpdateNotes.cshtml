@model List<NoteVM>
@{
    ViewData["Title"] = "Update Notes";
    var noteDataList = Model.ToList();
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card table-card">
            <div class="card-header pb-0">
                <h4>
                    @(ViewData["Title"])
                    @if (noteDataList.Count == 0)
                    {
                        <span class="float-right">
                                    <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                        </span>
                    }
                </h4>
            </div>
            <div class="card-body @(noteDataList.Count > 0?"":"text-center")">
                @if (noteDataList.Count > 0)
                {
                    <form asp-action="UpdateNotes" method="post" id="seqForm">
                        <div id="noteEditor">
                            @for (int i = 0; i < noteDataList.Count; i++)
                            {
                                <div class="note-item d-flex w-100" data-index="@i">
                                    <input type="hidden" name="notes[@i].ID" value="@noteDataList[i].ID" />
                                    <input type="number" class="form-control form-control-sm seq-input" name="notes[@i].Seq" value="@noteDataList[i].Seq"
                                          data-index="@i" />
                                    <div class="seq-error text-danger" style="font-size: 0.9em;"></div>
                                    <textarea class="form-control" rows="3" readonly>@noteDataList[i].EnTitle</textarea>
                                    <textarea class="form-control" rows="3" readonly>@noteDataList[i].UrduTitle</textarea>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                    </form>
                    <hr />
                    <h3>Live Preview</h3>
                    <div id="livePreview"></div>
                }
                else
                {
                    <img class="error_img" src="~/assets/images/no-data.png" />
                }
            </div>
        </div>
    </div>
</div>
      @section Scripts {
<script>
    const seqInputs = document.querySelectorAll('.seq-input');
        const noteData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(noteDataList));

    function renderPreviewAndValidate() {
        const seqMap = {};
        const updatedNotes = [];

        seqInputs.forEach((input, i) => {
            const errorDiv = input.parentElement.querySelector('.seq-error');
            const value = parseInt(input.value);
            const note = { ...noteData[i], Seq: value };

            updatedNotes.push(note);

            // Reset error
            errorDiv.textContent = "";

            // Validation for duplicate Seq
            if (!isNaN(value)) {
                if (seqMap[value]) {
                    errorDiv.textContent = `Duplicate Seq: ${value} already used.`;
                } else {
                    seqMap[value] = true;
                }
            }
        });

        // Sort and render live preview
        updatedNotes.sort((a, b) => a.Seq - b.Seq);

        const preview = document.getElementById("livePreview");
        preview.innerHTML = "";

        updatedNotes.forEach(note => {
            const div = document.createElement("div");
                    div.innerHTML = `<strong>${note.Seq}</strong> - ${note.EnTitle} <br/><em>${note.UrduTitle}</em><hr/>`;
            preview.appendChild(div);
        });
    }

    seqInputs.forEach(input => {
        input.addEventListener('input', renderPreviewAndValidate);
    });

    // Initial render
    renderPreviewAndValidate();
</script>
}
