@model EventVM
@{
    ViewData["Title"] = $"{Model.Title} Details";
    var _Message = TempData["Message"] as string;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
    bool isModerator = (await _authorizationService.AuthorizeAsync(User, "Moderator")).Succeeded ? true : false;
    bool isUser = (await _authorizationService.AuthorizeAsync(User, "User")).Succeeded ? true : false;
}
@if (isSuperAdmin || isAdmin || isModerator || isUser)
{
    @if (isModerator || isUser)
    {
        <style>
            .buttons-excel {
                display: none !important;
            }
        </style>
    }
    <div class="row">
        <div class="col-xl-12">
            <h4 class="card-title">
                @(ViewData["Title"])
                <span class="float-right">
                    @if (isSuperAdmin || isAdmin)
                    {
                        <a asp-action="Index" asp-controller="ShowExpense" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Expense Details</a>
                    }
                    <a asp-action="Index" class="btn btn-primary sm-btn">Back</a>
                </span>
            </h4>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-xl-6">
            <div class="card event_dtl_card">
                <div class="card-body">
                    @{
                        string _dateNarration = Model.StartDate.Value.ToString("dddd, dd MMMM yyyy");
                        if (Model.EndDate.HasValue)
                        {
                            _dateNarration += $" till {Model.EndDate.Value.ToString("dddd, dd MMMM yyyy")}";
                        }
                    }
                    @if (Model.EventCategoriesList != null && Model.EventCategoriesList.Count > 0)
                    {
                        <h4>
                            <i class="bx bx-bar-chart"></i>
                            @foreach (var _category in Model.EventCategoriesList)
                            {
                                <span class="badge bg-info">@(_category)</span>
                            }
                        </h4>
                    }
                    <h4>
                        <i class="bx bx bx-calendar-event"></i> @(_dateNarration)
                    </h4>
                    <h4>
                        <i class="bx bx-location-plus"></i> @(Model.AuditoriumTitle), @(Model.VenueTitle), @(Model.CityTitle), @(Model.CountryTitle)
                    </h4>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr />
                        <p class="event_desc_p"> @Html.Raw(Model.Description.Trim().Replace("\n", "<br>"))</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        string _src = "no-image-found.png";
                        if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            _src = $"events/{Model.ImagePath}";
                        }
                        <img src="~/assets/images/@(_src)" class="event_dtl_img" />
                    }
                </div>
            </div>
        </div>
    </div>
    @if (isSuperAdmin || isAdmin)
    {
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="mfh-machine-profile">
                                <ul class="nav nav-tabs" id="myTab1" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="home-tab1" data-bs-toggle="tab" href="#shows" role="tab" aria-controls="home" aria-selected="true">Shows</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="profile-tab20" data-bs-toggle="tab" href="#reservations" role="tab" aria-controls="profile" aria-selected="false">Reservations</a>
                                    </li>
                                </ul>
                                <div class="tab-content ad-content2" id="myTabContent2">
                                    <div class="tab-pane fade show active" id="shows" role="tabpanel">
                                        <h4 class="card-title mb-2">
                                            Shows For @(Model.Title)
                                            @if (isSuperAdmin && !string.IsNullOrEmpty(Model.EventStatusTitle)
                                           && Model.EventStatusTitle.Trim().ToLower() != "ended")
                                            {
                                                <span class="float-right mb-2">
                                                    <a asp-action="AddOrEdit" asp-controller="Show" asp-route-ID="0" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Add Show</a>
                                                </span>
                                            }
                                        </h4>
                                        @if (Model.ShowsList != null)
                                        {
                                            <table id="showTable" class="table display table-striped table-bordered dt-responsive nowrap mt-2" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Time</th>
                                                        <th>Action</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.ShowsList.Count > 0)
                                                    {
                                                        foreach (var item in Model.ShowsList)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @(item.Date.Value.ToString("dddd, dd MMMM yyyy"))
                                                                </td>
                                                                <td>
                                                                    @(DateTime.Today.Add(item.Time.Value).ToString("hh:mm tt"))
                                                                </td>
                                                                <td>
                                                                    <a asp-action="ViewTickets" asp-controller="Show" asp-route-ID="@(item.ID)" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn" target="_blank">View Tickets</a>
                                                                    @if (isSuperAdmin && !item.IsEnded)
                                                                    {
                                                                        <button type="button" class="btn btn-danger sm-btn endShowBtn" data-id="@(item.ID)">End</button>
                                                                        <a asp-action="UpdateTickets" asp-controller="Show" asp-route-ID="@(item.ID)" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Update Tickets</a>
                                                                        <a asp-action="AddOrEdit" asp-controller="Show" asp-route-ID="@(item.ID)" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Edit</a>
                                                                        <button type="button" class="btn btn-danger sm-btn deleteShowBtn" data-id="@(item.ID)">Delete</button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        int _colspan = 3;
                                                        <tr>
                                                            <td colspan="@(_colspan)" class="text-center">
                                                                <img class="error_img" src="~/assets/images/no-data.png" />
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                    <div class="tab-pane fade" id="reservations" role="tabpanel">
                                        <h4 class="card-title mb-2">
                                            Reservations For @(Model.Title)
                                            @if ((isSuperAdmin || isAdmin) && !string.IsNullOrEmpty(Model.EventStatusTitle)
                                           && Model.EventStatusTitle.Trim().ToLower() != "ended")
                                            {
                                                <span class="float-right mb-2">
                                                    <a asp-action="AddOrEdit" asp-controller="Reservation" asp-route-ID="0" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Add Reservation</a>
                                                </span>
                                            }
                                        </h4>
                                        @if (Model.ReservationList != null)
                                        {
                                            <table id="reservationTable" class="table display table-striped table-bordered dt-responsive nowrap mt-2" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>Ticket #</th>
                                                        <th class="">Customer Name</th>
                                                        <th class="d-none">Customer Phone</th>
                                                        <th class="d-none">Show Date</th>
                                                        <th class="d-none">Total Amount</th>
                                                        @if (isAdmin || isSuperAdmin)
                                                        {
                                                            <th>Booking Status</th>
                                                        }
                                                        @if (isSuperAdmin)
                                                        {
                                                            <th>Created By User</th>
                                                            <th>Approved By User</th>
                                                        }
                                                        <th>Action</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.ReservationList.Count > 0)
                                                    {
                                                        foreach (var item in Model.ReservationList)
                                                        {
                                                            string _trBgColor = "primary";
                                                            if (!string.IsNullOrEmpty(item.ReservationStatusTitle))
                                                            {
                                                                if (item.ReservationStatusTitle.Trim().ToLower() == "arrival pending")
                                                                {
                                                                    _trBgColor = "warning";
                                                                }
                                                                if (item.ReservationStatusTitle.Trim().ToLower() == "cancelled")
                                                                {
                                                                    _trBgColor = "danger";
                                                                }
                                                                else if (item.ReservationStatusTitle.Trim().ToLower() == "refunded")
                                                                {
                                                                    _trBgColor = "light";
                                                                }
                                                                else if (item.ReservationStatusTitle.Trim().ToLower() == "closed" || item.ReservationStatusTitle.Trim().ToLower() == "not attended")
                                                                {
                                                                    _trBgColor = "success-light";
                                                                }
                                                            }
                                                            <tr class="bg bg-@(_trBgColor)">
                                                                <td>@(item.TicketNumber)</td>
                                                                <td>@(item.CustomerName)</td>
                                                                <td class="d-none">@(item.CustomerPhone)</td>
                                                                <td class="d-none">@(item.ShowDateTime)</td>
                                                                <td class="d-none">@(item.AmountPaid)</td>
                                                                @if (isAdmin || isSuperAdmin)
                                                                {
                                                                    <td>
                                                                        @{
                                                                            string _actionStatus = "Pending";
                                                                            string _bgColor = "warning";
                                                                            if (item.IsApproved.HasValue)
                                                                            {
                                                                                if (item.IsApproved.Value == true)
                                                                                {
                                                                                    _actionStatus = "Approved";
                                                                                    _bgColor = "success";
                                                                                }
                                                                                else
                                                                                {
                                                                                    _actionStatus = "Rejected";
                                                                                    _bgColor = "danger";
                                                                                }
                                                                            }
                                                                            <span class="badge bg-@(_bgColor)">@(_actionStatus)</span>
                                                                        }
                                                                    </td>
                                                                }
                                                                @if (isSuperAdmin)
                                                                {
                                                                    <td>
                                                                        @(!string.IsNullOrEmpty(item.CreatedByUserName) ? item.CreatedByUserName : "-")
                                                                    </td>
                                                                    <td>
                                                                        @(!string.IsNullOrEmpty(item.ApprovedByUserName) ? item.ApprovedByUserName : "-")
                                                                    </td>
                                                                }
                                                                <td>
                                                                    @if (item.IsApproved.HasValue && item.IsApproved.Value == true)
                                                                    {

                                                                        <a asp-action="Details" asp-controller="Reservation" asp-route-ID="@(item.ID)" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn" target="_blank">Details</a>
                                                                        if (!string.IsNullOrEmpty(Model.EventStatusTitle)
                                                                        && Model.EventStatusTitle.Trim().ToLower() != "ended" && !string.IsNullOrEmpty(item.ReservationStatusTitle)
                                                                        && item.ReservationStatusTitle.Trim().ToLower() != "closed")
                                                                        {
                                                                            <a class="btn btn-danger sm-btn closeRsvBtn" data-id="@(item.ID)">Close</a>
                                                                        }
                                                                    }
                                                                    @if (isSuperAdmin && !string.IsNullOrEmpty(Model.EventStatusTitle)
                                                                   && Model.EventStatusTitle.Trim().ToLower() != "ended")
                                                                    {
                                                                        <a asp-action="AddOrEdit" asp-controller="Reservation" asp-route-ID="@(item.ID)" asp-route-EventID="@(Model.ID)" class="btn btn-primary sm-btn">Edit</a>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        int _colspan = 2;
                                                        if (isAdmin)
                                                        {
                                                            _colspan = 3;
                                                        }
                                                        else if (isSuperAdmin)
                                                        {
                                                            _colspan = 6;
                                                        }
                                                        <tr>
                                                            <td colspan="@(_colspan)" class="text-center">
                                                                <img class="error_img" src="~/assets/images/no-data.png" />
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Delete Show Modal-->
        <div class="modal fade" id="deleteShowModal" tabindex="-1" role="dialog" aria-labelledby="deleteShowModalCenterTitle" aria-hidden="true" style="display:none;">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteShowModalCenterTitle">Delete Show</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <form method="post" asp-action="Delete" asp-controller="Show" class="delete_form">
                        <div class="modal-body">
                            <input type="hidden" name="ID" class="selectedIdElement" />
                            <input type="hidden" name="EventID" value="@(Model.ID)" />
                            <p class="text-muted">Are you sure you want to delete this Show?</p>
                        </div>
                    </form>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger confirmDeleteBtn">Delete</button>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <!--End Show Modal-->
        <div class="modal fade" id="endShowModal" tabindex="-1" role="dialog" aria-labelledby="endShowModalCenterTitle" aria-hidden="true" style="display:none;">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="endShowModalCenterTitle">End Show</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <form method="post" asp-controller="Show" asp-action="End" class="end_form">
                        <div class="modal-body">
                            <input type="hidden" name="ID" class="selectedIdElement" />
                            <input type="hidden" name="EventID" value="@(Model.ID)" />
                            <p class="text-muted">Are you sure you want to end this Show?</p>
                        </div>
                    </form>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger confirmBtn">Yes</button>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">No</button>
                    </div>
                </div>
            </div>
        </div>
        <!--Close Rsv Modal-->
        <div class="modal fade" id="closeRsvModal" tabindex="-1" role="dialog" aria-labelledby="closeRsvModalCenterTitle" aria-hidden="true" style="display:none;">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="closeRsvModalCenterTitle">Close Reservation</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <form method="post" asp-action="Close" asp-controller="Reservation" class="close_form">
                        <div class="modal-body">
                            <input type="hidden" name="ID" class="selectedIdElement" />
                            <input type="hidden" name="EventID" value="@(Model.ID)" />
                            <p class="text-muted">Are you sure you want to close this Reservation?</p>
                        </div>
                    </form>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger confirmBtn">Yes</button>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">No</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @section Scripts {
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/datatables.min.js"></script>
    <script src="~/assets/js/dataTables.responsive.min.js"></script>
    <!--Buttons js-->
    <script src="https://cdn.datatables.net/buttons/1.7.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.7.1/js/buttons.html5.min.js"></script>
    <script>
         document.addEventListener("DOMContentLoaded", function () {
                // Retrieve the last active tab from local storage
                const lastActiveTab = localStorage.getItem("lastActiveTab");
                if (lastActiveTab) {
                    // Deactivate all tabs and tab contents
                    document.querySelectorAll('.nav-tabs .nav-link').forEach(tab => tab.classList.remove('active'));
                    document.querySelectorAll('.tab-pane').forEach(content => content.classList.remove('show', 'active'));

                    // Activate the last active tab and its corresponding content
                    const activeTab = document.querySelector(`.nav-tabs .nav-link[href="${lastActiveTab}"]`);
                    const activeContent = document.querySelector(lastActiveTab);

                    if (activeTab && activeContent) {
                        activeTab.classList.add('active');
                        activeContent.classList.add('show', 'active');
                    }
                }
                // Add click event listeners to save the active tab to local storage
                document.querySelectorAll('.nav-tabs .nav-link').forEach(tab => {
                    tab.addEventListener('click', function () {
                        localStorage.setItem("lastActiveTab", this.getAttribute('href'));
                    });
                });
            });
                   $(document).ready(function(){
          $('#showTable').DataTable({responsive:true});
          $('#reservationTable').DataTable({
                          responsive:true,
            dom: 'Bfrtip', // This defines the position of the buttons
            buttons: [
                {
                    extend: 'excelHtml5', // This creates an Excel export button
                    className: 'btn btn-primary',
                    text: 'Export to Excel', // Button text
                    title: 'Reservations For @(Model.Title.ToUpper())' // Optional: Title for the Excel file
                }
            ]
        });
          //Delete Show Functionality
          $(document).on('click', '.deleteShowBtn', function(){
            var selectedID = $(this).data("id");
            $("#deleteShowModal .selectedIdElement").val(selectedID);
            $("#deleteShowModal").modal("show");
          });
          $("#deleteShowModal .confirmDeleteBtn").click(function(){
            $("#deleteShowModal .delete_form").submit();
            $("#deleteShowModal").modal("hide");
          });
          $(document).on('click', '.closeRsvBtn', function(){
            var selectedID = $(this).data("id");
            $("#closeRsvModal .selectedIdElement").val(selectedID);
            $("#closeRsvModal").modal("show");
          });
          $("#closeRsvModal .confirmBtn").click(function(){
            $("#closeRsvModal .close_form").submit();
            $("#closeRsvModal").modal("hide");
          });
          // End Show functionality
             $(document).on('click', '.endShowBtn', function(){
                var selectedID = $(this).data("id");
                $("#endShowModal .selectedIdElement").val(selectedID);
                $("#endShowModal").modal("show");
            });
            $("#endShowModal .confirmBtn").click(function(){
                $("#endShowModal .end_form").submit();
                $("#endShowModal").modal("hide");
            });
        });

    </script>
    @if (_Message != null)
        {
            if (_Message.StartsWith("1"))
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('success', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
            else
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('error', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
        }
    }
}
else
{
    Layout = "_EmptyLayout";
    @(await Html.PartialAsync("~/Views/Shared/_NotAuthorizedView.cshtml"))
}