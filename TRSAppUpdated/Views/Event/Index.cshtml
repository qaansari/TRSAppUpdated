@model List<EventVM>
@{
    ViewData["Title"] = "Events";
    var _Message = TempData["Message"] as string;
    string _PageTitle = "Event";
    string _PartialViewName = _PageTitle.Contains(" ") ? _PageTitle.Replace(" ", "") : _PageTitle;
    int _TotalRecords = ViewBag.TotalRecords;
    int _PageNo = ViewBag.PageNo;
    int _PageSize = ViewBag.PageSize;
    int _TotalPages = (int)Math.Ceiling((double)_TotalRecords / _PageSize);
    string _searchedTerm = ViewBag.SearchedTerm != null ? ViewBag.SearchedTerm as string : string.Empty;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
    bool isModerator = (await _authorizationService.AuthorizeAsync(User, "Moderator")).Succeeded ? true : false;
    bool isUser = (await _authorizationService.AuthorizeAsync(User, "User")).Succeeded ? true : false;
}
@if (isSuperAdmin || isAdmin || isModerator || isUser)
{
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card table-card">
                <div class="card-header pb-0">
                    <h4>
                        @(ViewData["Title"])
                        @if (isSuperAdmin || isAdmin)
                        {
                            <span class="float-right">
                                <a asp-action="AddOrEdit" asp-route-ID="0" class="btn btn-primary sm-btn">Add @_PageTitle</a>
                            </span>
                        }
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.Count > 0)
                    {
                        <!-- Filters Row -->
                        <div class="row mb-3">
                            <div class="col-md-12 d-flex flex-wrap align-items-end gap-2">
                                <button class="btn btn-outline-primary filter-btn" data-filter="thisMonth">This Month</button>
                                <button class="btn btn-outline-primary filter-btn" data-filter="thisWeek">This Week</button>
                                <div>
                                    <label class="form-label mb-0">From:</label>
                                    <input type="date" id="startDate" class="form-control form-control-sm" />
                                </div>
                                <div>
                                    <label class="form-label mb-0">To:</label>
                                    <input type="date" id="endDate" class="form-control form-control-sm" />
                                </div>
                                <button class="btn btn-outline-primary" id="customDateBtn">Apply Date Range</button>
                                <div>
                                    <select id="cityFilter" class="form-control form-control-sm">
                                        <option value="">All Cities</option>
                                        <option value="Karachi">Karachi</option>
                                        <option value="Lahore">Lahore</option>
                                        <option value="Islamabad">Islamabad</option>
                                        <!-- Add more cities as needed -->
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                show
                                <select id="pageSizeDropdown" class="w-20 form-control form-control-sm">
                                    <option value="10" selected="@(_PageSize == 10)">10</option>
                                    <option value="20" selected="@(_PageSize == 20)">20</option>
                                    <option value="50" selected="@(_PageSize == 50)">50</option>
                                    <option value="100" selected="@(_PageSize == 100)">100</option>
                                </select>
                                entries
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="d-flex form-inline mb-3">
                                    <span class="search_span">Search</span> <input type="text" id="searchInput" class="form-control mr-2" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                    }
                    <!-- Table container that will be updated via AJAX -->
                    <div id="tableContainer">
                        @await Html.PartialAsync($"_{_PartialViewName}TablePartial", Model)
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--Delete Modal-->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true" style="display:none;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalCenterTitle">Delete @(_PageTitle)</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form method="post" asp-action="Delete" class="delete_form">
                    <div class="modal-body">
                        <input type="hidden" name="ID" class="selectedIdElement" />
                        <p class="text-muted">Are you sure you want to delete this @(_PageTitle)?</p>
                    </div>
                </form>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger confirmDeleteBtn">Delete</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(document).ready(function(){
                    var currentSearchTerm = '@_searchedTerm';
            $('#searchInput').val(currentSearchTerm);
                 // Search functionality
            var searchTimeout;
            $('#searchInput').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    loadData(1); // Always reset to page 1 when search term changes
                }, 500); // 500ms delay after typing stops
            });

            $('#searchInput').keypress(function(e) {
                if(e.which == 13) { // Enter key
                    clearTimeout(searchTimeout);
                    loadData(1);
                }
            });
                // Delete functionality
                 $(document).on('click', '.deleteBtn', function(){
                    var selectedID = $(this).data("id");
                    $(".selectedIdElement").val(selectedID);
                    $("#deleteModal").modal("show");
                });
                $(".confirmDeleteBtn").click(function(){
                    $(".delete_form").submit();
                    $("#deleteModal").modal("hide");
                });

                // Search functionality with AJAX
                $('#searchBtn').click(function() {
                    loadData(1);
                });
                     $('#pageSizeDropdown').change(function() {
                // Reset to page 1 when changing page size
                loadData(1);
            });
                $('#searchInput').keypress(function(e) {
                    if(e.which == 13) { // Enter key
                        loadData(1);
                    }
                });

                // Pagination with AJAX
                $(document).on('click', '.page-link', function(e) {
                    e.preventDefault();
                    var pageNo = $(this).data('page');
                    loadData(pageNo);
                });

                // Function to load Events via AJAX
                     function loadData(pageNo) {
                var searchedTerm = $('#searchInput').val();
                var pageSize = $('#pageSizeDropdown').val(); // Get selected page size
                var filterType = $('.filter-btn.active').data('filter') || "";
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();
                var city = $('#cityFilter').val();

                $.ajax({
                    url: '@Url.Action("GetPartial")',
                    type: 'GET',
                    data: {
                        _pageNo: pageNo || 1,
                        _pageSize: pageSize, // Use selected page size
                        _searchedTerm: searchedTerm
                    },
                    beforeSend: function() {
                        // Show loading indicator if needed
                    },
                    success: function(data) {
                        $('#tableContainer').html(data);
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading Events:', error);
                        // Show error message if needed
                    }
                });
            }
            });

            @if (_Message != null)
            {
                                if (_Message.StartsWith("1"))
                                {
                                                    <text>
                                                                                    Lobibox.notify('success', {
                                                                                        pauseDelayOnHover: true,
                                                                                        size: 'mini',
                                                                                        icon: 'bx bx-info-circle',
                                                                                        continueDelayOnInactiveTab: false,
                                                                                        position: 'bottom right',
                                                                                        msg: '@(_Message.Substring(2))',
                                                                                        soundPath: '/assets/sounds/'
                                                                                    });
                                                    </text>
                                }
                                else
                                {
                                                    <text>
                                                                                    Lobibox.notify('error', {
                                                                                        pauseDelayOnHover: true,
                                                                                        size: 'mini',
                                                                                        icon: 'bx bx-info-circle',
                                                                                        continueDelayOnInactiveTab: false,
                                                                                        position: 'bottom right',
                                                                                        msg: '@(_Message.Substring(2))',
                                                                                        soundPath: '/assets/sounds/'
                                                                                    });
                                                    </text>
                                }
            }
        </script>
    }
}
else
{
    Layout = "_EmptyLayout";
    @(await Html.PartialAsync("~/Views/Shared/_NotAuthorizedView.cshtml"))
}