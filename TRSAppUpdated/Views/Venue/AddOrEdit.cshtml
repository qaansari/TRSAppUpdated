@model VenueVM
@{
    string _fn = "Add";
    if (Model.ID != 0)
    {
        _fn = "Edit";
    }
    string _PageTitle = "Venue";
    ViewData["Title"] = $"{_fn} {_PageTitle}";
}
<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
    <div class="card">
        <div class="card-header">
            <h4>@(ViewData["Title"])</h4>
        </div>
        <div class="card-body">
            <form class="separate-form" enctype="multipart/form-data" method="post" asp-action="AddOrEdit">
                <input type="hidden" asp-for="ID"/>
                <input type="hidden" asp-for="ImagePath"/>
                <input type="hidden" asp-for="CreatedByUserID"/>
                <input type="hidden" asp-for="CreatedDateTime"/>
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label class="col-form-label">Title <span class="text-danger">*</span></label>
                                <input class="form-control" type="text" placeholder="Enter @_PageTitle Title" asp-for="Title">
                                <span asp-validation-for="Title"></span>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label class="col-form-label">Picture</label>
                                <input class="form-control" type="file" asp-for="ImageFile">
                            </div>
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label class="col-form-label">Address <span class="text-danger">*</span></label>
                                <input class="form-control" type="text" placeholder="Enter @_PageTitle Address">
                                <span asp-validation-for="Address"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <input class="btn btn-primary" type="submit">
                        <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>