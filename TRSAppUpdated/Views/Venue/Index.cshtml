@model List<VenueVM>
@{
    ViewData["Title"] = "Venues";
    var _Message = TempData["Message"] as string;
    string _PageTitle = "Venue";
    int _TotalRecords = ViewBag.TotalRecords;
    int _PageNo = ViewBag.PageNo;
    int _PageSize = ViewBag.PageSize;
    int _TotalPages = (int)Math.Ceiling((double)_TotalRecords / _PageSize);
    string searchTerm = ViewBag.SearchedTerm != null ? ViewBag.SearchedTerm as string : string.Empty;
    int _startRecord = (_PageNo - 1) * _PageSize + 1;
    int _endRecord = Math.Min(_PageNo * _PageSize, _TotalRecords);

}
<div class="row">
    <!-- Styled Table Card-->
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card table-card">
            <div class="card-header pb-0">
                <h4>
                    @(ViewData["Title"])
                    <span class="float-right">
                        <a asp-action="AddOrEdit" asp-route-ID="0" class="btn btn-primary sm-btn">Add @_PageTitle</a>
                    </span>
                </h4>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6">
                        <form method="get" asp-action="Index" class="d-flex form-inline mb-3 float-right">
                            <input type="text" name="searchedTerm" class="form-control mr-2 w-75" placeholder="Search..." />
                            <button type="submit" class="btn btn-primary sm-btn">Search</button>
                        </form>
                    </div>
                </div>
                <table id="@(_PageTitle)" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    @{
                                        string _src = "no-image-found.png";
                                        if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            _src = $"venues/{item.ImagePath}";
                                        }
                                    }
                                    <td>
                                        <img src="~/assets/images/@(_src)" alt="" class="tabular_img">
                                        <span>@(item.Title)</span>
                                    </td>
                                    <td>@(item.Address)</td>
                                    <td>
                                        <a asp-action="AddOrEdit" asp-route-ID="@(item.ID)" class="btn btn-primary sm-btn">Edit</a>
                                        <button type="button" class="btn btn-primary sm-btn deleteBtn" data-id="@(item.ID)">Delete</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">
                                    <img class="error_img" src="~/assets/images/no-data.png" />
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
                <div class="dataTables_info" id="buttons-datatable_info" role="status" aria-live="polite">Showing @(_startRecord) to @(_endRecord) of @(_TotalPages) entries</div>
                <div class="dataTables_paginate paging_simple_numbers" id="buttons-datatable_paginate">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(_PageNo == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-_pageNo="@(_PageNo - 1)" asp-route-_pageSize="@_PageSize" asp-route-searchTerm="@searchTerm">Previous</a>
                            </li>
                            @for (int i = 1; i <= _TotalPages; i++)
                            {
                                <li class="page-item @(i == _PageNo ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-_pageNo="@i" asp-route-_pageSize="@_PageSize" asp-route-searchTerm="@searchTerm">@i</a>
                                </li>
                            }
                            <li class="page-item @(_PageNo == _TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-_pageNo="@(_PageNo + 1)" asp-route-_pageSize="@_PageSize" asp-route-searchTerm="@searchTerm">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Delete Modal-->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalCenterTitle">Delete @(_PageTitle)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="post" asp-action="Delete" class="delete_form">
                <div class="modal-body">
                    <input type="hidden" name="ID" class="selectedIdElement" />
                    <p class="text-muted">Are you sure you want to delete this @(_PageTitle)?</p>
                </div>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger confirmDeleteBtn">Delete</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function(){
            //DataTable
            $('#@(_PageTitle)').DataTable({
                responsive: true
            });
            //Delete
            $(".deleteBtn").click(function(){
            var selectedID=$(this).data("id");
            $(".selectedIdElement").val(selectedID);
            $("#deleteModal").modal("show");
            });
            $(".confirmDeleteBtn").click(function(){
            $(".delete_form").submit();
            $("#deleteModal").modal("hide");
            });
        });
    </script>
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}