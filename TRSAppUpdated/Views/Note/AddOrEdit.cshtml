@model NoteVM
@{
    string _fn = "Add";
    if (Model.ID != 0)
    {
        _fn = "Edit";
    }
    string _PageTitle = "Note";
    ViewData["Title"] = $"{_fn} {_PageTitle}";
    var _Message = TempData["Message"] as string;
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <h4>@(ViewData["Title"])</h4>
            </div>
            <div class="card-body">
                <form class="separate-form" enctype="multipart/form-data" method="post" asp-action="AddOrEdit">
                    <input type="hidden" asp-for="ID" />
                    <input type="hidden" asp-for="Seq" />
                    <input type="hidden" asp-for="CreatedByUserID" />
                    <input type="hidden" asp-for="CreatedDateTime" />
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Note Type <span class="text-danger">*</span></label>
                                    <ejs-dropdownlist cssClass="form-control form-control-sm" dataSource="@(ViewData["NoteTypeList"])" placeholder="Select a note type"
                                                      allowFiltering="true" ejs-for="NoteTypeID" popupHeight="220px">
                                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <span asp-validation-for="NoteTypeID"></span>
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">English Title <span class="text-danger">*</span></label>
                                    <textarea class="form-control" type="text"
                                              rows="3" placeholder="Enter @_PageTitle Title (English)" asp-for="EnTitle">
                                          </textarea>
                                    <span asp-validation-for="EnTitle"></span>
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Urdu Title <span class="text-danger">*</span></label>
                                    <textarea class="form-control" type="text"
                                              rows="3" placeholder="Enter @_PageTitle Title (Urdu)" asp-for="UrduTitle">
                                          </textarea>
                                    <span asp-validation-for="UrduTitle"></span>
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group mb-0">
                                    <input class="btn btn-primary" type="submit">
                                    <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}