@model SeatVM
@{
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
    bool isModerator = (await _authorizationService.AuthorizeAsync(User, "Moderator")).Succeeded ? true : false;
    bool isUser = (await _authorizationService.AuthorizeAsync(User, "User")).Succeeded ? true : false;
    ViewData["Title"] = $"Ticket Details";
    var _Message = TempData["Message"] as string;
    int _EventID = ViewBag.EventID != null ? ViewBag.EventID : 0;
    int _TSeats = Model.Rows.SelectMany(x => x.Columns).SelectMany(x => x.SeatTickets).Count();
}
@if (isSuperAdmin || isAdmin || isModerator || isUser)
{
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="info w-100">
                <div class="form-group mb-0 float-right my-2 mr-5px">
                    <a class="btn btn-danger btn-sm" href="@Url.Action("Details", "Event", new { ID = _EventID })">Back</a>
                </div>
                <h1 class="fw-bold text-uppercase text-center">@(Model.EventName) dated @(Model.ShowDate.Value.ToString("dddd, dd MMMM yyyy"))</h1>
                <h1 class="fw-bold text-uppercase text-center">@(Model.AuditoriumName)</h1>
            </div>
            <div class="info w-100 my-2">
                <h5 class="fw-bold text-uppercase text-right">No of Seats: @(_TSeats)</h5>
                <h5 class="fw-bold text-uppercase text-right">Estd. Revenue: @(Model.EstimatedRevenue)</h5>
                <h5 class="fw-bold text-uppercase text-right">After Discont: @(Model.AfterDiscountRevenue)</h5>
                <h5 class="fw-bold text-uppercase text-right">Total Sale: @(Model.AmountReceived)</h5>
            </div>
            <div class="w-100">
                @foreach (var row in Model.Rows)
                {
                    @if (Model.AuditoriumAlignment.ToLower() == "right")
                    {
                        row.Columns = row.Columns.ToList().AsEnumerable().Reverse().ToList();
                    }
                    <div class="seat-row mt-2">
                        <span class="row_label mr-5px fw-bold">@row.RowLabel (@(row.Category) - @(row.CostPrice))</span>
                        @foreach (var column in row.Columns)
                        {
                            @if (Model.AuditoriumAlignment.ToLower() == "right")
                            {
                                column.SeatTickets = column.SeatTickets.ToList().AsEnumerable().Reverse().ToList();
                            }
                            foreach (var seat in column.SeatTickets)
                            {
                                <div class="@(_TSeats <= 450 ? "seat_bigger" : "seat") @(seat.IsReserved ? "reserved" : "")" title="Price: @seat.CostPrice">
                                    @seat.SeatNumber
                                </div>
                            }
                            <div class="column-gap"></div>
                        }
                        <span class="row_label fw-bold">@row.RowLabel (@(row.Category) - @(row.CostPrice))</span>
                    </div>
                }

            </div>
        </div>
    </div>
}
else
{
    Layout = "_EmptyLayout";
    @(await Html.PartialAsync("~/Views/Shared/_NotAuthorizedView.cshtml"))
}