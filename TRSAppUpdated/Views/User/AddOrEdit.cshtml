@model UserVM
@{
    string _fn = "Add";
    if (Model.ID != 0)
    {
        _fn = "Edit";
    }
    string _PageTitle = "User";
    ViewData["Title"] = $"{_fn} {_PageTitle}";
    var _Message = TempData["Message"] as string;
}
<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <h4>@(ViewData["Title"])</h4>
            </div>
            <div class="card-body">
                <form class="separate-form" enctype="multipart/form-data" method="post" asp-action="AddOrEdit">
                    <input type="hidden" asp-for="ID" />
                    <input type="hidden" asp-for="CreatedByUserID" />
                    <input type="hidden" asp-for="CreatedDateTime" />
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Role <span class="text-danger">*</span></label>
                                    <ejs-dropdownlist cssClass="form-control form-control-sm" dataSource="@(ViewData["RoleList"])" placeholder="Select a role"
                                                      allowFiltering="true" ejs-for="RoleID" popupHeight="220px">
                                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <span asp-validation-for="RoleID"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">First Name <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter First Name" asp-for="FirstName">
                                    <span asp-validation-for="FirstName"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Last Name <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Last Name" asp-for="LastName">
                                    <span asp-validation-for="LastName"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Contact # <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Contact Number" asp-for="ContactNumber">
                                    <span asp-validation-for="ContactNumber"></span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label class="col-form-label">Email <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" placeholder="Enter Email" asp-for="Email">
                                    <span asp-validation-for="Email"></span>
                                </div>
                            </div>
                            @if (Model.ID == 0)
                            {
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="col-form-label">Password <span class="text-danger">*</span></label>
                                        <input class="form-control" type="text" placeholder="Enter Password" asp-for="Password">
                                        <span asp-validation-for="Password"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input class="form-control" type="hidden" placeholder="Enter Password" asp-for="Password">
                            }
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6">
                                <div class="form-group">
                                    <div class="checkbox">
                                        <input id="isActiveChk" type="checkbox" asp-for="IsActive">
                                        <label for="isActiveChk">Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-6">
                                <div class="form-group">
                                    <div class="checkbox">
                                        <input id="isVerifiedChk" type="checkbox" asp-for="IsVerified">
                                        <label for="isVerifiedChk">Verified</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group mb-0">
                                    <input class="btn btn-primary" type="submit">
                                    <a class="btn btn-danger" href="@(Url.Action("Index"))">Back</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}