@inject IAuthorizationService _authorizationService
@{
    ViewData["Title"] = "Dashboard";
    var _Message = TempData["Message"] as string;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
}
    @await Html.PartialAsync("~/Views/Dashboard/_AdminDashboard.cshtml")
@section Scripts {
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}