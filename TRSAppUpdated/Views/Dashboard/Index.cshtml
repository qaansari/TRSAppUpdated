@inject IAuthorizationService _authorizationService
@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    var _Message = TempData["Message"] as string;
    bool isSuperAdmin = (await _authorizationService.AuthorizeAsync(User, "SuperAdmin")).Succeeded ? true : false;
    bool isAdmin = (await _authorizationService.AuthorizeAsync(User, "Admin")).Succeeded ? true : false;
    int _EventID = ViewBag.EventID;
    int _ShowID = ViewBag.ShowID;
}
@if (isSuperAdmin || isAdmin)
{
    <!-- Dashboard Start -->

    <div class="row mb-2">
        <div class="col-md-6">
            <!-- Start Card-->
            <div class="card ad-info-card">
                <div class="card-body dd-flex align-items-center">
                    <div class="icon-info">
                        <i class='bx bx-group'></i>
                    </div>
                    <div class="icon-info-text">
                        <h5 class="ad-title">Happy Users</h5>
                        <h4 class="ad-card-title">@(Model.TotalUsers)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <!-- Start Card-->
            <div class="card ad-info-card">
                <div class="card-body dd-flex align-items-center">
                    <div class="icon-info">
                        <i class='bx bx-calendar'></i>
                    </div>
                    <div class="icon-info-text">
                        <h5 class="ad-title">Upcoming Events</h5>
                        <h4 class="ad-card-title">@(Model.TotalEvents)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <form asp-action="Index">
        <div class="row mb-2">
            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-form-label">Event <span class="text-danger">*</span></label>
                    <ejs-dropdownlist id="EventDD" cssClass="form-control form-control-sm" dataSource="@(ViewData["EventList"])" placeholder="Select an event"
                                      allowFiltering="true" name="EventID" popupHeight="220px"
                                      change="eventChange" value="@_EventID">
                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-form-label">Show <span class="text-danger">*</span></label>
                    <ejs-dropdownlist id="ShowDD" cssClass="form-control form-control-sm" dataSource="@(ViewData["ShowList"])" placeholder="Select a show"
                                      allowFiltering="true" name="ShowID" popupHeight="220px" enabled="false" value="@_ShowID">
                        <e-dropdownlist-fields value="ID" text="ShowDateTime"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                </div>
            </div>
            <div class="col-md-4 align-self-center">
                <div class="form-group mb-0">
                    <input class="btn btn-primary" type="submit">
                    @if (_EventID != 0 || _ShowID != 0)
                    {
                        <a class="btn btn-danger" href="@(Url.Action("Index", new { EventID = 0, ShowID = 0 }))">Clear</a>
                    }
                </div>
            </div>
        </div>
    </form>

    @if (_EventID != 0)
    {
        <div class="row">
            <div class="col-md-6">
                <!-- Start Card-->
                <div class="card ad-info-card">
                    <div class="card-body dd-flex justify-content-center align-items-center">
                        <div class="icon-info-text ">
                            @{
                                string _imgSrc = "no-image-found.png";
                                if (!string.IsNullOrEmpty(Model.EventImagePath))
                                {
                                    _imgSrc = $"events/{Model.EventImagePath.Trim()}";
                                }
                            }
                            <img src="~/assets/images/@(_imgSrc)" class="db_event_image" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <!-- Start Card-->
                <div class="card ad-info-card">
                    <div class="card-body dd-flex align-items-center">
                        <div class="icon-info">
                            <i class='bx  bx-calendar-event'></i>
                        </div>
                        <div class="icon-info-text">
                            <h5 class="ad-title">Event Name</h5>
                            <h4 class="ad-card-title">@(Model.EventTitle)</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <!-- Start Card-->
                <div class="card ad-info-card">
                    <div class="card-body dd-flex align-items-center">
                        <div class="icon-info">
                            <i class='bx bx-wallet'></i>
                        </div>
                        <div class="icon-info-text">
                            <h5 class="ad-title">Expense</h5>
                            <h4 class="ad-card-title">@(Model.Expense)</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <!-- Start Card-->
                <div class="card ad-info-card">
                    <div class="card-body dd-flex align-items-center">
                        <div class="icon-info">
                            <i class='bx bx-wallet'></i>
                        </div>
                        <div class="icon-info-text">
                            <h5 class="ad-title">Income</h5>
                            <h4 class="ad-card-title">@(Model.Revenue)</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <!-- Start Card-->
                <div class="card ad-info-card">
                    <div class="card-body dd-flex align-items-center">
                        <div class="icon-info">
                            <i class='bx bx-wallet'></i>
                        </div>
                        <div class="icon-info-text">
                            <h5 class="ad-title">Profit</h5>
                            <h4 class="ad-card-title">@(Model.Profit)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script>
        function eventChange() {
            var eventObj = document.getElementById('EventDD').ej2_instances[0];
            var show = document.getElementById('ShowDD').ej2_instances[0];
            show.enabled = true;
            var tempQuery = new ej.data.Query().where('EventID', 'equal', eventObj.value);
            show.query = tempQuery;
            show.text = null;
            show.dataBind();
        }
    </script>

    @section Scripts {
        @if (_Message != null)
        {
            if (_Message.StartsWith("1"))
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('success', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
            else
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('error', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
        }
    }
}
