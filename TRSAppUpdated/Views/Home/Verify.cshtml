@{
    ViewData["Title"] = "Verification";
    bool _isVerified = ViewBag.IsVerified;
    Layout = "_EmptyLayout";
    var _Message = TempData["Message"] as string;
}
@if (_isVerified)
{
    <div class="fb-main-404section text-center">
        <div class="fb-404page">
            <img src="~/assets/images/success.png" class="error_img" alt="">
            <h1>Great... Your email has been verified successfully!!!</h1>
            <p>Login to continue to access the website</p>
            <div class="fb-404btn">
                <a href="~/Home/Index" class="ad-btn">back to login</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="fb-main-404section text-center">
        <div class="fb-404page">
            <img src="~/assets/images/unauthorized-error.png" class="error_img" alt="">
            <h1>Oops... You are unauthorized!!!</h1>
            <p>Do not Worry, Login to continue to access the desired page</p>
            <div class="fb-404btn">
                <a href="~/Home/Index" class="ad-btn">back to login</a>
            </div>
        </div>
    </div>
}
@section Scripts {
    @if (_Message != null)
    {
        if (_Message.StartsWith("1"))
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('success', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
        else
        {
            <script>
                $(document).ready(function () {
                    Lobibox.notify('error', {
                        pauseDelayOnHover: true,
                        size: 'mini',
                        icon: 'bx bx-info-circle',
                        continueDelayOnInactiveTab: false,
                        position: 'bottom right',
                        msg: '@(_Message.Substring(2))',
                        soundPath: '/assets/sounds/'
                    });
                });
            </script>
        }
    }
}
