                                        </svg>
                                    </div>
                                    <span asp-validation-for="LastName"></span>
                                </div>
                                <div class="ad-auth-feilds mb-30">
                                    <input type="text" placeholder="Enter Contact Number" class="ad-input" asp-for="ContactNumber">
