                                            <path fill-rule="evenodd" fill="rgb(154, 190, 237)" d="M13.696,9.759 C12.876,8.942 11.901,8.337 10.837,7.971 C11.989,7.180 12.742,5.850 12.725,4.349 C12.698,1.961 10.713,0.031 8.318,0.062 C5.946,0.093 4.026,2.026 4.026,4.398 C4.026,5.879 4.774,7.189 5.914,7.971 C4.850,8.337 3.875,8.942 3.055,9.759 C1.786,11.025 1.026,12.663 0.878,14.426 C0.849,14.768 1.117,15.063 1.462,15.063 L1.466,15.063 C1.772,15.063 2.024,14.827 2.050,14.523 C2.325,11.285 5.057,8.734 8.375,8.734 C11.694,8.734 14.425,11.285 14.701,14.523 C14.727,14.827 14.979,15.063 15.285,15.063 L15.289,15.063 C15.634,15.063 15.902,14.768 15.873,14.426 C15.725,12.663 14.965,11.025 13.696,9.759 ZM8.375,7.562 C6.625,7.562 5.201,6.143 5.201,4.398 C5.201,2.653 6.625,1.234 8.375,1.234 C10.126,1.234 11.550,2.653 11.550,4.398 C11.550,6.143 10.126,7.562 8.375,7.562 Z"></path>
                                        </svg>
                                    </div>
                                    <span asp-validation-for="ContactNumber"></span>
                                </div>
                                <div class="ad-auth-feilds mb-30">
                                    <input type="file" placeholder="Enter Image" class="ad-input" asp-for="ImageFile">
                                    <div class="ad-auth-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="16px" height="16px">
                                            <path fill-rule="evenodd" fill="rgb(154, 190, 237)" d="M13.696,9.759 C12.876,8.942 11.901,8.337 10.837,7.971 C11.989,7.180 12.742,5.850 12.725,4.349 C12.698,1.961 10.713,0.031 8.318,0.062 C5.946,0.093 4.026,2.026 4.026,4.398 C4.026,5.879 4.774,7.189 5.914,7.971 C4.850,8.337 3.875,8.942 3.055,9.759 C1.786,11.025 1.026,12.663 0.878,14.426 C0.849,14.768 1.117,15.063 1.462,15.063 L1.466,15.063 C1.772,15.063 2.024,14.827 2.050,14.523 C2.325,11.285 5.057,8.734 8.375,8.734 C11.694,8.734 14.425,11.285 14.701,14.523 C14.727,14.827 14.979,15.063 15.285,15.063 L15.289,15.063 C15.634,15.063 15.902,14.768 15.873,14.426 C15.725,12.663 14.965,11.025 13.696,9.759 ZM8.375,7.562 C6.625,7.562 5.201,6.143 5.201,4.398 C5.201,2.653 6.625,1.234 8.375,1.234 C10.126,1.234 11.550,2.653 11.550,4.398 C11.550,6.143 10.126,7.562 8.375,7.562 Z"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="ad-auth-feilds mb-30">
                                    <ejs-dropdownlist cssClass="ad-input" dataSource="@(ViewData["CountryList"])" placeholder="Select a country"
                                                      allowFiltering="true" ejs-for="CountryID" popupHeight="220px">
                                        <e-dropdownlist-fields value="ID" text="Title"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                    <div class="ad-auth-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 482.8 482.8"><path d="M395.95,210.4h-7.1v-62.9c0-81.3-66.1-147.5-147.5-147.5c-81.3,0-147.5,66.1-147.5,147.5c0,7.5,6,13.5,13.5,13.5    s13.5-6,13.5-13.5c0-66.4,54-120.5,120.5-120.5c66.4,0,120.5,54,120.5,120.5v62.9h-275c-14.4,0-26.1,11.7-26.1,26.1v168.1    c0,43.1,35.1,78.2,78.2,78.2h204.9c43.1,0,78.2-35.1,78.2-78.2V236.5C422.05,222.1,410.35,210.4,395.95,210.4z M395.05,404.6    c0,28.2-22.9,51.2-51.2,51.2h-204.8c-28.2,0-51.2-22.9-51.2-51.2V237.4h307.2L395.05,404.6L395.05,404.6z" data-original="#000000" class="active-path" data-old_color="#000000" fill="#9abeed"></path><path d="M241.45,399.1c27.9,0,50.5-22.7,50.5-50.5c0-27.9-22.7-50.5-50.5-50.5c-27.9,0-50.5,22.7-50.5,50.5    S213.55,399.1,241.45,399.1z M241.45,325c13,0,23.5,10.6,23.5,23.5s-10.5,23.6-23.5,23.6s-23.5-10.6-23.5-23.5    S228.45,325,241.45,325z" data-original="#000000" class="active-path" data-old_color="#000000" fill="#9abeed"></path></svg>
                                    </div>
                                    <span asp-validation-for="CountryID"></span>
                                </div>
                                <div class="ad-auth-feilds mb-30">
                                    <input type="text" placeholder="Email Address" class="ad-input" asp-for="Email">
                                    <div class="ad-auth-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 483.3 483.3"><path d="M424.3,57.75H59.1c-32.6,0-59.1,26.5-59.1,59.1v249.6c0,32.6,26.5,59.1,59.1,59.1h365.1c32.6,0,59.1-26.5,59.1-59.1    v-249.5C483.4,84.35,456.9,57.75,424.3,57.75z M456.4,366.45c0,17.7-14.4,32.1-32.1,32.1H59.1c-17.7,0-32.1-14.4-32.1-32.1v-249.5    c0-17.7,14.4-32.1,32.1-32.1h365.1c17.7,0,32.1,14.4,32.1,32.1v249.5H456.4z" data-original="#000000" class="active-path" data-old_color="#000000" fill="#9abeed"></path><path d="M304.8,238.55l118.2-106c5.5-5,6-13.5,1-19.1c-5-5.5-13.5-6-19.1-1l-163,146.3l-31.8-28.4c-0.1-0.1-0.2-0.2-0.2-0.3    c-0.7-0.7-1.4-1.3-2.2-1.9L78.3,112.35c-5.6-5-14.1-4.5-19.1,1.1c-5,5.6-4.5,14.1,1.1,19.1l119.6,106.9L60.8,350.95    c-5.4,5.1-5.7,13.6-0.6,19.1c2.7,2.8,6.3,4.3,9.9,4.3c3.3,0,6.6-1.2,9.2-3.6l120.9-113.1l32.8,29.3c2.6,2.3,5.8,3.4,9,3.4    c3.2,0,6.5-1.2,9-3.5l33.7-30.2l120.2,114.2c2.6,2.5,6,3.7,9.3,3.7c3.6,0,7.1-1.4,9.8-4.2c5.1-5.4,4.9-14-0.5-19.1L304.8,238.55z" data-original="#000000" class="active-path" data-old_color="#000000" fill="#9abeed"></path></svg>
                                    </div>
                                    <span asp-validation-for="Email"></span>
                                </div>
                                <div class="ad-auth-feilds position-relative">
                                    <!-- Left Lock Icon -->
                                    <div class="left-icon">
                                        <!-- Your existing SVG -->
                                        <!-- Eye SVG -->
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 482.8 482.8" width="20" height="20" style="display:block;"> <path d="M395.95,210.4h-7.1v-62.9c0-81.3-66.1-147.5-147.5-147.5c-81.3,0-147.5,66.1-147.5,147.5c0,7.5,6,13.5,13.5,13.5 s13.5-6,13.5-13.5c0-66.4,54-120.5,120.5-120.5c66.4,0,120.5,54,120.5,120.5v62.9h-275c-14.4,0-26.1,11.7-26.1,26.1v168.1 c0,43.1,35.1,78.2,78.2,78.2h204.9c43.1,0,78.2-35.1,78.2-78.2V236.5C422.05,222.1,410.35,210.4,395.95,210.4z M395.05,404.6c0,28.2-22.9,51.2-51.2,51.2h-204.8c-28.2,0-51.2-22.9-51.2-51.2V237.4h307.2L395.05,404.6L395.05,404.6z" fill="#9abeed" /> <path d="M241.45,399.1c27.9,0,50.5-22.7,50.5-50.5c0-27.9-22.7-50.5-50.5-50.5c-27.9,0-50.5,22.7-50.5,50.5 S213.55,399.1,241.45,399.1z M241.45,325c13,0,23.5,10.6,23.5,23.5s-10.5,23.6-23.5,23.6s-23.5-10.6-23.5-23.5 S228.45,325,241.45,325z" fill="#9abeed" /> </svg>
                                    </div>
                                    <!-- Password Input -->
                                    <input type="password" placeholder="Password" class="ad-input" asp-for="Password" id="passwordInput" />
                                    <!-- Right Toggle Icon (Eye / Eye-Slash) -->
                                    <div class="right-icon" id="togglePassword">
                                        <!-- Eye SVG -->
                                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="20" height="20" fill="#9abeed">
                                            <path d="M572.52 241.4c1.36 2.6 3.48 6.9 3.48 14.6s-2.12 12-3.48 14.6C518.41 366.59 407.84 448 288 448S57.59 366.59 3.48 270.6C2.12 268 0 263.1 0 256.1s2.12-12 3.48-14.6C57.59 145.41 168.16 64 288 64s230.41 81.41 284.52 177.4zM288 400c79.53 0 160-61.41 204.7-144C448 173.41 367.53 112 288 112S128 173.41 83.3 256c44.7 82.59 125.17 144 204.7 144zm0-240a96 96 0 1 1 0 192 96 96 0 1 1 0-192z" />
                                        </svg>
                                        <!-- Eye Slash SVG -->
                                        <svg id="eyeSlashIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="20" height="20" fill="#9abeed" style="display:none;">
                                            <path d="M633.82 458.1L598.6 423.5c25.8-25.2 41.4-52.2 45.4-59.1 1.4-2.6 3.5-6.9 3.5-14.6s-2.1-12-3.5-14.6c-26-47.2-65.1-87.1-112-115.4C502.8 202.4 480.3 192 456 192c-5.2 0-10.4 .2-15.5 .7L316.4 66.7c-5.5-5.5-14.3-5.5-19.8 0L24.1 339.3c-5.5 5.5-5.5 14.3 0 19.8l39.6 39.6c5.5 5.5 14.3 5.5 19.8 0L104.3 378c47.5 36.3 105.8 58 167.7 58c22.5 0 44.6-2.9 65.9-8.2l54.2 54.2c5.5 5.5 14.3 5.5 19.8 0l60.2-60.2 60.2 60.2c5.5 5.5 14.3 5.5 19.8 0l39.6-39.6c5.5-5.5 5.5-14.3 0-19.8zM288 400c-79.5 0-160-61.4-204.7-144C128 173.4 208.5 112 288 112c18.7 0 36.9 3 54 8.6l65.7 65.7C389.4 172.1 368.1 160 344 160c-53 0-96 43-96 96 0 24.1 12.1 45.4 30.3 58.7l25.5 25.5C292.6 340.1 290.3 340 288 340z" />
                                        </svg>
                                    </div>
                                    <span asp-validation-for="Password"></span>
                                </div>
                            </div>
                            <div class="ad-auth-btn">
                                <button type="submit" class="ad-btn ad-login-member">Sign up</button>
                            </div>
                            <p class="ad-register-text">Already have an account ? <a href="~/Home/Index">Login</a></p>
                        </form>
                    </div>
                </div>
            </div>
            <div class="ad-notifications ad-error">
                <p><span>Duhh!</span>Something Went Wrong</p>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
                             $(document).on('click', '#togglePassword', function(){
                const passwordInput = $('#passwordInput');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);

                $('#eyeIcon').toggle();        // 👈 your eye icon
                $('#eyeSlashIcon').toggle();   // 👈 this SVG
            });

        </script>
        @if (_Message != null)
        {
            if (_Message.StartsWith("1"))
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('success', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
            else
            {
                <script>
                    $(document).ready(function () {
                        Lobibox.notify('error', {
                            pauseDelayOnHover: true,
                            size: 'mini',
                            icon: 'bx bx-info-circle',
                            continueDelayOnInactiveTab: false,
                            position: 'bottom right',
                            msg: '@(_Message.Substring(2))',
                            soundPath: '/assets/sounds/'
                        });
                    });
                </script>
            }
        }
    }
}
else
{
    <div class="fb-main-404section text-center">
        <div class="fb-404page">
            <img src="~/assets/images/coming-soon.png" class="error_img" alt="">
            <h1>Oops... You are unauthorized!!!</h1>
            <p>Do not Worry, Login to continue to access the desired page</p>
            <div class="fb-404btn">
                <a href="~/Home/Index" class="ad-btn">back to login</a>
            </div>
        </div>
    </div>
}
